# Solo para desarrollo local (hot-reload con `nest start --watch`).
# No se usa para build/deploy: eso lo sigue haciendo Render con
# `npm run deploy:prod` (ver README, sección Despliegue).
FROM node:20-bookworm-slim

# argon2 es un módulo nativo; si no hay binario prebuilt para esta
# plataforma, npm lo compila desde código fuente al instalar.
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

EXPOSE 3001

CMD ["npm", "run", "start:dev"]
